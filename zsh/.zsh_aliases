# make everything neovim
alias v="nvim"
alias vi="nvim"
alias vim="nvim"

# reload Waybar
alias reloadwaybar="pkill waybar && hyprctl dispatch exec waybar"

# configs
alias confighyprland="nvim ~/.config/hypr/hyprland.lua"
alias configwaybar="nvim ~/.config/waybar/config.jsonc"

# color ls
alias ls="ls --color=auto"

# wireguard
alias vpnon="nmcli connection up crankys_lab"
alias vpnoff="nmcli connection down crankys_lab"

# fix applications not being recognized in Hyprland
alias fixapplications="XDG_MENU_PREFIX=arch- kbuildsycoca6"

# make kitty work with ssh
alias ssh="kitten ssh"

# cheat to cheese
alias cheese="cheat"

# fuzzy find and open in vim
alias vf='nvim $(fzf)'
